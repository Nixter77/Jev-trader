BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FAPI_BASE=https://testnet.binancefuture.com
# Real-money production (optional, dangerous):
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_ALLOW_LIVE=I_UNDERSTAND
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY=0
typesafe_API_KEY=

# Decision model: jev (TypeSafe cloud API) or laya (local HF weights)
DECISION_BACKEND=jev
# Laya checkpoint when DECISION_BACKEND=laya: multilingual | english | typed-decisions | router
LAYA_CHECKPOINT=typed-decisions
# Optional torch device for Laya: cpu | cuda | mps
# LAYA_DEVICE=cpu
# Watch-list size when DECISION_BACKEND=laya (default 5; Jev keeps 15)
# LAYA_UNIVERSE_SIZE=5

# Entry guards (entries only; closes/stops/kill/daily_loss flatten unaffected)
# No-new-entry local window (DST-correct). Empty/off disables. Default 03:00-09:00.
NO_ENTRY_WINDOW=03:00-09:00
NO_ENTRY_TZ=Asia/Jerusalem
# Max buy_long fills across all symbols in the rolling last hour. 0 = unlimited.
MAX_ENTRIES_PER_HOUR=2
# After N consecutive losing closes, pause new entries for M minutes. 0 disables.
LOSS_STREAK_PAUSE_N=3
LOSS_STREAK_PAUSE_MIN=120
